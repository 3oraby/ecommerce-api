doctype html
html
  head
    title Payment Successful
    style.
      body {
        font-family: Arial;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #f0fdf4;
      }
      .box {
        text-align: center;
        padding: 40px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      }
      h1 {
        color: #16a34a;
      }
  body
    .box
      h1 Payment Successful
      p Your order has been placed successfully