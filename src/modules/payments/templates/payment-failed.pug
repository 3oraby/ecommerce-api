doctype html
html
  head
    title Payment Failed
    style.
      body {
        font-family: Arial;
        display: flex;
        justify-content: center;
        align-items: center;
        height: 100vh;
        background: #fef2f2;
      }
      .box {
        text-align: center;
        padding: 40px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
      }
      h1 {
        color: #dc2626;
      }
  body
    .box
      h1 Payment Failed
      p Please try again or use another payment method.